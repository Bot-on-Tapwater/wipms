# Production image: builds the app, then runs the small standalone server
# (output: "standalone" in next.config.ts) as a non-root user.

# ---- 1. Install dependencies ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ---- 2. Build ----
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# The backend address is written into the browser code at build time,
# so it is a build argument (set in docker-compose.prod.yml), not a runtime variable.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- 3. Run ----
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S ijenga && adduser -S ijenga -G ijenga

COPY --from=builder --chown=ijenga:ijenga /app/public ./public
COPY --from=builder --chown=ijenga:ijenga /app/.next/standalone ./
COPY --from=builder --chown=ijenga:ijenga /app/.next/static ./.next/static

USER ijenga

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/login || exit 1

CMD ["node", "server.js"]
