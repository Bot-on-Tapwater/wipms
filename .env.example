# Copy to .env and fill in real values. NEVER commit .env.
# Used by both docker-compose.yml (local) and docker-compose.prod.yml.

# ---- General ----
APP_NAME=Ijenga API
# local | staging | production (production refuses a weak SECRET_KEY)
ENVIRONMENT=local

# ---- PostgreSQL (the db container is created with these) ----
POSTGRES_DB=ijenga
POSTGRES_USER=ijenga
POSTGRES_PASSWORD=change-this-db-password
# Must match the values above. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://ijenga:change-this-db-password@db:5432/ijenga

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60

# ---- Frontend / CORS ----
# Comma separated list of allowed browser origins.
# In production set it to the frontend address, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000
# Used for links inside emails (password reset, "Open work")
FRONTEND_URL=http://localhost:3000
# Backend address used by the browser (local docker-compose.yml only).
# Production builds use https://BACKEND_DOMAIN automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Roles ----
# Comma separated emails allowed to self-register as main contractor
MAIN_CONTRACTOR_EMAILS=
# Password for the create_superuser script. Leave empty to be asked at the prompt.
SUPERUSER_PASSWORD=

# ---- Email (SMTP). When false, emails are only written to the log ----
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ---- Uploads ----
MEDIA_DIR=media
MAX_UPLOAD_SIZE_MB=5

# ---- Payments (mocked until the bank API is available) ----
PAYMENT_PROVIDER=mock
# 0 = every mock payment succeeds; e.g. 0.2 = about 20% fail (for testing)
MOCK_PAYMENT_FAILURE_RATE=0
# Share of the project wallet payments may use (old rule: 99%)
WALLET_USABLE_RATIO=0.99
# Retention share of a work's total cost (old rule: 10%)
RETENTION_RATE=0.10

# ---- Production only (docker-compose.prod.yml / Traefik) ----
BACKEND_DOMAIN=api.example.com
FRONTEND_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
# Gunicorn worker processes
WEB_CONCURRENCY=3
